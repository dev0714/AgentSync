# Supabase project that hosts the `agentsync` schema.
# Project Settings → API. The schema itself is NOT exposed to the Data API —
# the app reaches it through the public.agentsync_* wrapper functions, which are
# granted to the service role only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Server-side only. Bypasses row-level security — never expose this to a browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookie. At least 32 characters.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Authorises /api/v1/worker/tick. Internal plumbing — a source-system key must
# never be able to drive the queue, so this is a separate secret.
# Generate with:  openssl rand -base64 32
WORKER_SECRET=

# Set by Vercel when you configure a cron secret; the tick endpoint accepts it
# as well, so the scheduled invocation needs no extra header.
CRON_SECRET=

# Not yet used — the planner stage refuses to run without it rather than
# pretending to succeed.
ANTHROPIC_API_KEY=
